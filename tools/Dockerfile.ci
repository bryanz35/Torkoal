# Authoritative Linux CI environment (docs/DESIGN.md §10.1).
#
# Supplies only the OS baseline. Pinned tools, the Python environment, and npm
# packages are installed by tools/bootstrap.sh from tools/toolchain.lock.json
# inside the mounted checkout. The base image is pinned by digest and apt
# resolves against a fixed Ubuntu archive snapshot; tools/doctor.py checks
# both values against the lock file.
FROM docker.io/library/ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ARG UBUNTU_SNAPSHOT=20261015T000000Z
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# snapshot.ubuntu.com is HTTPS-only, so trust roots come first from the
# signed live archive; the second step then resolves every package, including
# ca-certificates itself, against the fixed snapshot.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && apt-get update --snapshot "${UBUNTU_SNAPSHOT}" \
    && apt-get install --snapshot "${UBUNTU_SNAPSHOT}" -y --no-install-recommends --allow-downgrades \
        build-essential \
        ca-certificates \
        curl \
        git \
        python3 \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

WORKDIR /work
